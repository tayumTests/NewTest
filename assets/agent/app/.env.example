# Artifactory credentials (automatically provided on deployment)
# ARTIFACTORY_USER=
# ARTIFACTORY_TOKEN=

# SAP AI Core configuration (automatically provided on deployment)
# AICORE_BASE_URL=
# AICORE_CLIENT_ID=
# AICORE_CLIENT_SECRET=
# AICORE_AUTH_URL=

# Invoice monitoring configuration
INVOICE_THRESHOLD_AMOUNT=50000
INVOICE_THRESHOLD_DAYS=3
MONITORING_INTERVAL_HOURS=4

# Report configuration
REPORT_TIMEZONE=UTC
CFO_EMAIL=cfo@example.com
FROM_EMAIL=invoice-monitor@example.com

# S/4HANA mock API configuration
S4HANA_API_URL=http://localhost:5000/mock-s4hana
